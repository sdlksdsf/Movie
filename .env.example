# Copy to .env.local and restart — unlocks the live TMDB catalogue.
# A v3 API key or a v4 read access token both work.
NEXT_PUBLIC_TMDB_KEY=

# ---------------------------------------------------------------- 18+ vault
# The vault stays switched off until VAULT_PIN exists. Every route, API call and
# menu entry is then hidden behind a signed, httpOnly 45-minute session cookie
# that only this PIN can create — and only an "All maturity" adult profile is
# allowed to hold it. NOFLIX ships no adult media: point VAULT_FEED_URL at your
# own provider's JSON index (id, title, stream + optional poster/tags/duration).
VAULT_PIN=
VAULT_SECRET=
VAULT_FEED_URL=
VAULT_FEED_KEY=
