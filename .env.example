# Copy to .env.local and restart — unlocks the live TMDB catalogue.
# A v3 API key or a v4 read access token both work.
NEXT_PUBLIC_TMDB_KEY=

# ---------------------------------------------------------------- 18+ vault
# The vault stays switched off until VAULT_PIN exists. Every route, API call and
# menu entry is then hidden behind a signed, httpOnly 45-minute session cookie
# that only this PIN can create — and only an "All maturity" adult profile is
# allowed to hold it.
#
# NOFLIX hosts no adult media. Playback is the provider's own embed, in an
# iframe. Default provider is Eporner's public Webmasters API v2 (keyless);
# set VAULT_PROVIDER=custom to use your own JSON index instead, or =none to
# turn content off entirely while keeping the gate.
VAULT_PIN=
VAULT_SECRET=
VAULT_PROVIDER=
VAULT_ORDER=
VAULT_QUERY=
VAULT_PAGES=
# search / category / country facets reuse the same query endpoint and are
# cached for 5 minutes per term; nothing to configure there.
# only used when VAULT_PROVIDER=custom
VAULT_FEED_URL=
VAULT_FEED_KEY=
